{
  "@context": {
    "ia": "https://interopatlas.org/vocab/",
    "obj": "https://interopatlas.org/object/",
    "std": "https://interopatlas.org/standard/",
    "cap": "https://interopatlas.org/capability/",
    "org": "https://interopatlas.org/organization/",
    "rel": "https://interopatlas.org/relation/",
    "scn": "https://interopatlas.org/scenario/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "type": "@type",
    "name_zh": {"@id": "ia:name", "@language": "zh"},
    "name_en": {"@id": "ia:name", "@language": "en"},
    "description_zh": {"@id": "ia:description", "@language": "zh"},
    "description_en": {"@id": "ia:description", "@language": "en"},

    "source": {"@id": "ia:source", "@type": "@id"},
    "target": {"@id": "ia:target", "@type": "@id"},
    "relation": {"@id": "ia:relationType", "@type": "@vocab"},
    "confidence": {"@id": "ia:confidence", "@type": "xsd:decimal"},
    "conditions_zh": {"@id": "ia:conditions", "@language": "zh"},
    "conditions_en": {"@id": "ia:conditions", "@language": "en"},
    "capability_context": {"@id": "ia:capabilityContext", "@type": "@id", "@container": "@set"},
    "scenario_context": {"@id": "ia:scenarioContext", "@type": "@id", "@container": "@set"},
    "sources": {"@id": "ia:evidenceSource", "@container": "@set"},
    "url": {"@id": "ia:url", "@type": "@id"},
    "title": "ia:title",
    "language": "ia:language",
    "accessed": {"@id": "ia:accessed", "@type": "xsd:date"},

    "Standard": "ia:Standard",
    "Capability": "ia:Capability",
    "Organization": "ia:Organization",
    "Relation": "ia:Relation",
    "Scenario": "ia:Scenario",

    "uses": "ia:uses",
    "provides": "ia:provides",
    "governed_by": "ia:governedBy",
    "maps_to": "ia:mapsTo"
  }
}
