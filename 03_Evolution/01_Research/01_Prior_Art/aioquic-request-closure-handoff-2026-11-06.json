  "observations": [
    {
      "id": "O1",
      "claim": "The example resolves a request future on its terminal HeadersReceived/DataReceived event, not on send_headers return or a nonterminal header.",
      "sources": [
        "examples/http3_client.py#L202-L210",
        "examples/http3_client.py#L248-L272",
        "src/aioquic/h3/connection.py#L605-L684"
      ]
    },
    {
      "id": "O2",
      "claim": "The asyncio adapter sends each returned destination and re-arms the core timer; receive and timer callbacks drain events then transmit.",
      "sources": [
        "src/aioquic/asyncio/protocol.py#L109-L159",
        "src/aioquic/asyncio/protocol.py#L194-L235"
      ]
    },
    {
      "id": "O3",
      "claim": "The selected local/remote close paths defer terminal event queueing until close completion; the example already fails pending request futures on ConnectionTerminated.",
      "sources": [
        "src/aioquic/quic/connection.py#L488-L510",
        "src/aioquic/quic/connection.py#L563-L588",
        "src/aioquic/quic/connection.py#L710-L727",
        "src/aioquic/quic/connection.py#L1454-L1472",
        "src/aioquic/quic/connection.py#L1939-L1975",
        "examples/http3_client.py#L231-L246"
      ]
    },
    {
      "id": "O4",
      "claim": "An ordinary request-stream reset performs H3 cleanup without an H3 completion event; the example has no direct reset-to-request-waiter failure branch. Absent a later terminal HTTP event, connection termination or external handling, that selected path does not settle the future. This is not a reproduced hang or conformance verdict.",
      "sources": [
        "src/aioquic/h3/connection.py#L509-L532",
        "src/aioquic/h3/connection.py#L1521-L1568",
        "examples/http3_client.py#L202-L272"
      ]
    },
    {
      "id": "O5",
      "claim": "The selected real-QUIC memory fixture disables ACK delay/pacing, directly delivers to its given receiver without routing by returned destination, and does not implement the timer/close lifecycle in transfer. Other tests are not asserted absent.",
      "sources": [
        "tests/test_h3.py#L42-L83",
        "tests/test_connection.py#L192-L249",
        "tests/test_connection.py#L300-L309"
      ]
    }
  ],
