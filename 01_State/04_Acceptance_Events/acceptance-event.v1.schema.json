{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interopatlas.org/schema/acceptance-event.v1.schema.json",
  "title": "InteropAtlas Acceptance Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "candidate_id",
    "decision",
    "machine_route",
    "review",
    "authority",
    "evidence_basis",
    "decided_at"
  ],
  "properties": {
    "contract_version": {"const": "acceptance-event-v1"},
    "event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["accepted", "duplicate", "deferred", "rejected"]},
    "machine_route": {"enum": ["review_required", "duplicate_existing", "identity_review_required", "deferred"]},
    "accepted_canonical_id": {"type": "string", "minLength": 1},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "independent_from_executor", "notes"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "independent_from_executor": {"const": true},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_impact", "ordinary_path", "approver"],
      "properties": {
        "mutation_impact": {"enum": ["M0", "M1", "M2", "M3"]},
        "ordinary_path": {"type": "boolean"},
        "approver": {"type": ["string", "null"]}
      }
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"enum": ["accepted", "duplicate"]}}},
      "then": {"required": ["accepted_canonical_id"]}
    },
    {
      "if": {"properties": {"decision": {"const": "accepted"}}},
      "then": {"properties": {"machine_route": {"const": "review_required"}}}
    },
    {
      "if": {"properties": {"decision": {"const": "duplicate"}}},
      "then": {"properties": {"machine_route": {"const": "duplicate_existing"}}}
    },
    {
      "if": {"properties": {"authority": {"properties": {"mutation_impact": {"enum": ["M2", "M3"]}}}}},
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "ordinary_path": {"const": false},
              "approver": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
