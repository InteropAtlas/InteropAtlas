{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interopatlas.org/schemas/implementation.schema.json",
  "title": "InteropAtlas Implementation Object",
  "allOf": [
    {"$ref": "base-object.schema.json"},
    {
      "type": "object",
      "required": ["type", "kind"],
      "properties": {
        "type": {"const": "implementation"},
        "kind": {
          "type": "string",
          "enum": ["software", "library", "tool", "service", "platform_service", "hardware", "firmware", "reference_implementation"]
        },
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "uniqueItems": true
        },
        "open_source": {"type": "boolean"},
        "self_hostable": {"type": "boolean"},
        "license_expression": {"type": "string"},
        "deployment_models": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    }
  ]
}
