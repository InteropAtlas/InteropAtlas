{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interopatlas.org/schemas/scenario.schema.json",
  "title": "InteropAtlas Scenario Object",
  "allOf": [
    {"$ref": "base-object.schema.json"},
    {
      "type": "object",
      "required": ["type", "requires"],
      "properties": {
        "type": {"const": "scenario"},
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
              "role": {"type": "string"},
              "description_zh": {"type": "string"},
              "description_en": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["capability"],
            "properties": {
              "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
              "priority": {"type": "string", "enum": ["required", "preferred", "optional"]},
              "constraints": {"type": "object", "additionalProperties": true}
            },
            "additionalProperties": true
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "network_scope": {"type": "string", "enum": ["local", "lan", "wan", "internet", "offline", "mixed", "unknown"]},
            "mobility": {"type": "string", "enum": ["fixed", "mobile", "mixed", "unknown"]},
            "safety_critical": {"type": "boolean"},
            "real_time": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "success_criteria_zh": {"type": "array", "items": {"type": "string"}},
        "success_criteria_en": {"type": "array", "items": {"type": "string"}}
      }
    }
  ]
}
